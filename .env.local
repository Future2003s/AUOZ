# Local Development Environment
# File này OVERRIDE .env khi chạy npm run dev
# KHÔNG commit file này lên git

NEXT_PUBLIC_URL=http://localhost:3000

# Trỏ về backend local khi dev
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081
NEXT_PUBLIC_API_END_POINT=http://localhost:8081/api/v1
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8081/api/v1

NEXT_PUBLIC_API_VERSION=v1

# Translation API Key (phải khớp với TRANSLATION_API_KEY trong backend .env)
# Server-only: dùng trong Server Components & API routes
TRANSLATION_API_KEY=tr_api_key_dev_lalalycheee_2026
# Client-side: expose ra browser cho Admin UI client component
NEXT_PUBLIC_TRANSLATION_API_KEY=tr_api_key_dev_lalalycheee_2026