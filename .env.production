# Production Environment Variables
# Sử dụng khi: npm run build && npm run start
# PM2 load file này qua env_file trong ecosystem.config.js

NODE_ENV=production

NEXT_PUBLIC_URL=https://lalalycheee.vn

# Backend API
NEXT_PUBLIC_BACKEND_URL=https://api.lalalycheee.vn
NEXT_PUBLIC_API_END_POINT=https://api.lalalycheee.vn/api/v1
NEXT_PUBLIC_API_ENDPOINT=https://api.lalalycheee.vn/api/v1

NEXT_PUBLIC_API_VERSION=v1

NEXT_PUBLIC_URL_LOGO=https://res.cloudinary.com/duw5dconp/image/upload/v1752656796/logo_wrcmsg.png
